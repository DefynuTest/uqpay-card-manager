{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "baseUrl": "api",
    "paths": {
      "@shared/*": ["../shared/*"]
    }
  },
  "include": ["api/**/*", "shared/**/*"],
  "exclude": ["node_modules", "dist", "bots"]
}
