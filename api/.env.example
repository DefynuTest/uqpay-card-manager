# Card Manager API Configuration

PORT=4100

# Upstash Redis (serverless — get from https://console.upstash.com)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ZOQQ Portal Config API (to resolve tenant config)
CONFIG_BASE_URL=https://apinew.zoqq.com/zoqq/api/v1/config
CONFIG_X_API_KEY=

# Default domain (for single-tenant dev)
DEFAULT_DOMAIN=

# JWT secret for API token validation
JWT_SECRET=

# Subscription price
SUBSCRIPTION_PRICE=5

# Telegram Bot
TELEGRAM_BOT_TOKEN=
WEBHOOK_BASE_URL=https://your-app.vercel.app

# Claude AI Agent
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514

# Agent tuning
MAX_CONVERSATION_TURNS=50
MAX_TOOL_ROUNDTRIPS=10
